# 必须使用自己的 origin；不带路径、查询串或尾斜杠。
GATEWAY_PUBLIC_ORIGIN=https://mcp.example.com
GATEWAY_FULL_SCOPE_ENABLED=1
# 在受限环境文件中填写；空凭据会阻止启动。
GATEWAY_INTROSPECTION_CLIENT_ID=
GATEWAY_INTROSPECTION_CLIENT_SECRET=
# 与 Go 后端 AUTH_TOKEN 一致，不能提交真实值。
AUTH_TOKEN=
GATEWAY_PUBLISH_DB=/var/lib/xhs-mcp-domain-gateway/publish.sqlite3
